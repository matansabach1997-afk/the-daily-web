<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <% if (typeof pageStylesheet !== "undefined" && pageStylesheet) { %>
      <link rel="stylesheet" href="<%= pageStylesheet %>">
    <% } %>
    <script src="/js/main.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-content">
        <a class="site-name" href="/">The Daily Web</a>
        <%- include("navigation") %>
      </div>
      <p id="session-message" class="shell feedback" role="status" aria-live="polite"></p>
    </header>
