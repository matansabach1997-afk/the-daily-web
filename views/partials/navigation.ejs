<% const navUser = typeof currentUser === "undefined" ? null : currentUser; %>
<nav class="navigation" aria-label="Main navigation">
  <a href="/">Home</a>
  <a id="reporter-workspace-link" href="/reporter"<% if (navUser?.role !== "reporter") { %> hidden<% } %>>Reporter Workspace</a>
  <a id="editor-workspace-link" href="/editor"<% if (navUser?.role !== "editor") { %> hidden<% } %>>Editor Workspace</a>
  <a id="analytics-link" href="/analytics"<% if (navUser?.role !== "editor") { %> hidden<% } %>>Analytics</a>
  <a id="login-link" href="/login"<% if (navUser) { %> hidden<% } %>>Login</a>
  <div id="account-controls" class="account-controls"<% if (!navUser) { %> hidden<% } %>>
    <span id="current-user"><%= navUser ? `${navUser.username} (${navUser.role})` : "" %></span>
    <button id="logout-button" type="button" hidden>Logout</button>
    <noscript>Enable JavaScript to log out.</noscript>
  </div>
</nav>
